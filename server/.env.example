# AI-generated with Claude Sonnet 5.5, 2026-10-15, reviewed by Jaemin Kim
# Changed: server bootstraping
# AI-generated with Claude Sonnet 5.5, 2026-10-19, reviewed by Jaemin Kim
# Changed: LangChain LLM 설정
# AI-generated with Claude Sonnet 5.5, 2026-11-18, reviewed by Jaemin Kim
# Changed: 가드레일 판정 모델과 위험 임계값 추가

# ── App ─────────────────────────────────────────────
APP_NAME="Server API"
APP_VERSION="0.1.0"
ENVIRONMENT="local"          # local | staging | production
DEBUG=false

# ── Database (Postgres) ─────────────────────────────
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="server"
POSTGRES_PASSWORD="server"
POSTGRES_DB="server"

# ── JWT ─────────────────────────────────────────────
# local 이외 환경에서는 반드시 교체할 것 (기본값이면 기동 실패):  openssl rand -hex 32
JWT_SECRET_KEY="dev-only-secret-change-me-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── LLM (suggestions) ───────────────────────────────
# 비어 있으면 앱은 기동하지만 제안 생성은 실패한다.
OPENROUTER_API_KEY=""
SUGGESTION_MODEL="openai/gpt-6-luna"   # OpenRouter 모델 이름 (provider/model)
# 가드레일: 제안이 아이의 제한에 어긋날 확률을 판정하는 모델. 같은 OpenRouter 키를 쓴다.
GUARDRAIL_MODEL="typesafe/jev-1.14"
GUARDRAIL_RISK_THRESHOLD=0.3           # 이 확률(0~1) 이상이면 제안을 다시 쓰게 한다
